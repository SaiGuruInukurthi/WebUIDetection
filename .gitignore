# .gitignore for WebUIDetection
# Recommended ignores for environment, dataset archives, and editor files

# Conda environment files
.conda/
.condatmp/
conda-meta/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtualenvs
env/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/

# Dataset archives and large extracted dataset folder
webui-7k/
webui-7k\ -\ Copy/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
balanced_7k.zip-001.001
balanced_7k.zip-002.002
webui-balanced-7k-20260208T053018Z-1-003
balanced_7k


# YOLO dataset (converted images and labels - too large for git)
datasets/

# Training runs and model weights
runs/

# Pretrained model weights (download separately)
*.pt
*.onnx
*.torchscript

# Large manifest files (contain embedded bounding box data - regenerate from notebooks)
Models and outputs/Outputs/*/manifests/*_manifest.json

# YOLO model outputs
Models and outputs/Outputs/03_notebook/yolo_model_a/
Models and outputs/Outputs/04_notebook/yolo_model_b/

# Editor and IDE
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs, databases, and temporary files
*.log
*.sqlite
*.db
tmp/
temp/
*.tmp

# Build artifacts
build/
dist/
*.egg-info/

# Notes:
# - Model weights (.pt) are ignored - download from Ultralytics or use trained weights from runs/
# - datasets/ contains converted YOLO format data - regenerate from webui-7k if needed
# - runs/ contains training outputs - these can be large
