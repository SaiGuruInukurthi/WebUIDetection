# .gitignore for WebUIDetection
# Recommended ignores for environment, dataset archives, and editor files

# Conda environment files
.conda/
.condatmp/
conda-meta/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtualenvs
env/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/

# Dataset archives and large extracted dataset folder
webui-7k/
webui-7k\ -\ Copy/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# YOLO dataset (converted images and labels - too large for git)
datasets/

# Training runs and model weights
runs/

# Pretrained model weights (download separately)
*.pt
*.onnx
*.torchscript

# Editor and IDE
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs, databases, and temporary files
*.log
*.sqlite
*.db
tmp/
temp/
*.tmp

# Build artifacts
build/
dist/
*.egg-info/

# Notes:
# - Model weights (.pt) are ignored - download from Ultralytics or use trained weights from runs/
# - datasets/ contains converted YOLO format data - regenerate from webui-7k if needed
# - runs/ contains training outputs - these can be large
